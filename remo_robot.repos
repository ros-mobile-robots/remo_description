repositories:
  src/diffbot:
    type: git
    url: https://github.com/ros-mobile-robots/diffbot
    version: noetic-devel
  src/rplidar_ros:
    type: git
    url: https://github.com/Slamtec/rplidar_ros
    version: master
  src/raspicam_node:
    type: git
    url: https://github.com/UbiquityRobotics/raspicam_node
    version: kinetic
  src/robot_component_models:
    type: git
    url: https://github.com/ros-mobile-robots/robot_component_models
    # The meshes of Remo's purchased parts, such as the laser scanner and the Raspberry Pi
    version: "1.0.0"
