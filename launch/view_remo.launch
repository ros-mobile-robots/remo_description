<launch>
    <!-- Arguments -->
    <!--arg name="model" default="$(env DIFFBOT_MODEL)" doc="model type [diffbot, remo]"/-->
    <arg name="model" default="remo" doc="model type [diffbot, remo]"/>
    <arg name="description_package" default="$(eval find(arg('model') + '_description'))" />
    <!-- The laser scanner that Remo's model shows: a2 for the Slamtec RPLIDAR A2 or a1 for the
         RPLIDAR A1, without quotes. urdf_file passes the value to the xacro argument lidar_type
         with the inner quotes that remo.urdf.xacro expects, for example lidar_type:='a1'. -->
    <arg name="lidar_type" default="a2" doc="laser scanner type [a2, a1]"/>
    <!-- The command whose output is the robot's URDF. For another camera or single board
         computer, expand the xacro file into a file first and pass urdf_file:="cat /tmp/remo.urdf". -->
    <arg name="urdf_file" default="$(find xacro)/xacro '$(arg description_package)/urdf/$(arg model).urdf.xacro' &quot;lidar_type:='$(arg lidar_type)'&quot;" />

    <!-- Parsing xacro and setting robot_description parameter -->
    <param name="robot_description" command="$(arg urdf_file)" />
    <!-- Setting gui parameter to true for display joint slider -->
    <!-- param name="use_gui" value="true"/ -->
    <!-- Starting Joint state publisher node which will publish the joint values -->
    <!-- node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" /-->
    <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" />
    <!-- Starting robot state publish which will publish tf -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    <!-- Launch visualization in rviz -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find remo_description)/rviz/remo_description.rviz" required="true" />
</launch>