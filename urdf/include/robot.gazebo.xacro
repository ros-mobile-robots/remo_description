<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ros_control plugin -->
  <xacro:macro name="gazebo_ros_control" params="robotNamespace robotSimType:=gazebo_ros_control/DefaultRobotHWSim"> 
    <gazebo>
      <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
        <robotNamespace>${robotNamespace}</robotNamespace>
        <!--robotParam>/robot_description</robotParam-->
        <robotSimType>${robotSimType}</robotSimType>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- xacro to set the friction for the wheel. This patch was taken from the MIR
  repository. 
    https://github.com/dfki-ric/mir_robot/tree/noetic.
    https://github.com/dfki-ric/mir_robot/blob/a216d7374c21e360c94034d360b07fd7a4d42842/mir_description/urdf/include/mir_100.gazebo.xacro#L29
   -->
  <xacro:macro name="set_wheel_friction" params="link friction">
    <gazebo reference="${link}">
      <mu1 value="${friction}"/>
      <mu2 value="${friction}"/>
      <kp value="10000000.0"/>
      <kd value="1.0"/>
      <minDepth>0.01</minDepth>
    </gazebo>
  </xacro:macro>

  <!-- http://gazebosim.org/tutorials?tut=friction -->
  <!-- http://sdformat.org/spec?ver=1.5&elem=collision#ode_mu -->
  <!-- https://answers.ros.org/question/231880/how-to-improve-amcl-pose-estimate/ -->
  <!-- https://answers.ros.org/question/30539/choosing-the-right-coefficients-for-gazebo-simulation/ -->
  <xacro:macro name="set_all_wheel_frictions" params="friction" >
    <!--xacro:set_wheel_friction link="front_right" friction="${friction}"/-->
    <!--xacro:set_wheel_friction link="front_left" friction="${friction}"/-->
    <!--xacro:set_wheel_friction link="rear_caster_rotation_link" friction="${friction}"/-->
    <!--xacro:set_wheel_friction link="rear_caster_wheel_link" friction="${friction}"/-->
    <!-- Drive-wheel contacts in Gazebo, for the sphere collision in common_macros.urdf.xacro:
         - moderate friction (the friction argument) and compliant, damped contacts, with kp/kd
           as in set_wheel_friction above: on the sphere's single contact point, the old wheel
           settings (friction 200, kp 1e12, kd 0) let the wheels miss their speed commands;
         - minDepth 0: minDepth permits that much penetration before correction, and with these
           soft contacts the wheels crept into the ground;
         - no fdir1: Gazebo turns it with the collision frame, which spins with a sphere
           collision, so the old 0 0 1 would tilt into the contact normal and make them slip.
         See https://github.com/ros-mobile-robots/remo_description/pull/2 -->
    <gazebo reference="front_right_wheel">
      <mu1>${friction}</mu1>        <!-- Coefficient of friction (default 1) -->
      <mu2>${friction}</mu2>        <!-- Second coefficient of friction (default 1) -->
      <kp>10000000.0</kp>         <!-- "Stiffness"-equivalent coefficient for contact joints (default 1e12) -->
      <kd>1.0</kd>                <!-- "Damping"-equivalent coefficient for contact joints (default 1) -->
      <minDepth>0</minDepth>         <!-- minimum allowable depth before contact correction impulse is applied (default 0) -->
      <maxVel>0.01</maxVel> <!-- maximum contact correction velocity truncation term (default 0.01)-->
      <material>Gazebo/FlatBlack</material>
    </gazebo>

    <gazebo reference="front_left_wheel">
      <mu1>${friction}</mu1>
      <mu2>${friction}</mu2>
      <kp>10000000.0</kp>
      <kd>1.0</kd>
      <minDepth>0</minDepth>
      <maxVel>0.01</maxVel>
      <material>Gazebo/FlatBlack</material>
    </gazebo>

    <gazebo reference="rear_caster_rotation_link">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
      <kp>1000000000000</kp>
      <kd>0</kd>
      <minDepth>0.0</minDepth>
      <!-- maxVel>1.0</maxVel-->
      <!--fdir1>0 0 1</fdir1-->
      <material>Gazebo/FlatBlack</material>
    </gazebo>

    <gazebo reference="rear_caster_wheel_link">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
      <kp>1000000000000</kp>
      <kd>0</kd>
      <minDepth>0.01</minDepth>
      <!-- maxVel>10.0</maxVel -->
      <material>Gazebo/White</material>
    </gazebo>
  </xacro:macro>

</robot>